ENV=dev
PORT=8080

# postgres
DATABASE_URL=postgres://budget_me:budget_me@localhost:5432/budget_me?sslmode=disable

# cors (comma-separated)
CORS_ORIGINS=http://localhost:3000

# auth
# Signs session tokens — set a long random string, never commit the real one.
AUTH_SECRET=dev-secret-change-me
# From @BotFather; verifies Telegram Mini App initData. Optional in dev:
# without it only web login/registration works.
TELEGRAM_BOT_TOKEN=
