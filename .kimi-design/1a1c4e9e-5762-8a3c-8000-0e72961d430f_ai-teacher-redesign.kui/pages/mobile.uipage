  - id: m.entry
    type: frame
    position: [ 2390, 88 ]
    size: [ 390, 844 ]
    fill: $bg
    layout:
      type: flex
      direction: column
      overflow: hidden
    children:
      - id: m6.topbar
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            justifyContent: spaceBetween,
            alignItems: center,
            padding: [ 12, 16 ]
          }
        children:
          - id: m6.back
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, direction: row, gap: 6, alignItems: center }
            children:
              - {
                  id: m6.back.icon,
                  type: svg,
                  size: [ 12, 12 ],
                  icon: fas:chevron-left,
                  fill: $text.secondary
                }
              - {
                  id: m6.back.text,
                  type: text,
                  size: [ hug, hug ],
                  content: English,
                  fontSize: 13,
                  fontWeight: 500,
                  color: $text.secondary
                }
          - id: m6.settings
            type: frame
            size: [ 34, 34 ]
            cornerRadius: 6
            stroke: { color: $border, width: 1, alignment: inside }
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: m6.settings.icon,
                  type: svg,
                  size: [ 13, 13 ],
                  icon: fas:gear,
                  fill: $text.secondary
                }
      - id: m6.body
        type: frame
        size: [ fill, fill ]
        layout:
          {
            type: flex,
            direction: column,
            gap: 10,
            padding: [ 8, 16, 12, 16 ],
            overflow: hidden
          }
        children:
          - id: m6.badge
            type: frame
            size: [ hug, hug ]
            alignSelf: start
            cornerRadius: 6
            fill: $muted
            layout: { type: flex, padding: [ 3, 10 ] }
            children:
              - {
                  id: m6.badge.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Phrase,
                  fontSize: 11,
                  fontWeight: 600,
                  color: $text.secondary
                }
          - {
              id: m6.term,
              type: text,
              size: [ fill, hug ],
              content: security posture,
              fontSize: 20,
              fontWeight: 600,
              letterSpacing: -0.3,
              color: $text.primary
            }
          - {
              id: m6.transcription,
              type: text,
              size: [ hug, hug ],
              content: "/sɪˈkjʊərəti ˈpɒstʃər/",
              fontSize: 12,
              color: $text.tertiary
            }
          - {
              id: m6.translation,
              type: text,
              size: [ fill, hug ],
              content: "Состояние защищённости; уровень безопасности",
              fontSize: 15,
              fontWeight: 600,
              color: $text.primary
            }
          - {
              id: m6.source,
              type: text,
              size: [ fill, hug ],
              content: "Source: Server-side vulnerabilities — PortSwigger",
              fontSize: 11,
              color: $text.tertiary
            }
          - id: m6.status
            type: frame
            size: [ fill, 36 ]
            cornerRadius: 8
            fill: $muted
            layout: { type: flex, direction: row, padding: 3, gap: 2 }
            children:
              - id: m6.status.inbox
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m6.status.inbox.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Inbox,
                      fontSize: 12,
                      fontWeight: 500,
                      color: "#FFFFFF"
                    }
              - id: m6.status.learning
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m6.status.learning.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Learning,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: m6.status.known
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m6.status.known.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Known,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.secondary
                    }
          - {
              id: m6.div.1,
              type: frame,
              size: [ fill, 1 ],
              fill: $border,
              margin: [ 6, 0, 0, 0 ]
            }
          - id: m6.sec.breakdown
            type: frame
            size: [ fill, hug ]
            margin: [ 6, 0, 0, 0 ]
            layout: { type: flex, direction: column, gap: 4 }
            children:
              - {
                  id: m6.sec.breakdown.label,
                  type: text,
                  size: [ hug, hug ],
                  content: Breakdown,
                  fontSize: 12,
                  fontWeight: 600,
                  color: $text.secondary
                }
              - id: m6.sec.breakdown.text
                type: text
                size: [ fill, hug ]
                fontSize: 13
                lineHeight: 19
                color: $text.primary
                content: |
                  <strong>security</strong> — «безопасность», здесь в значении защищённости от атак. <strong>posture</strong> — буквально «осанка, поза»; переносно — «позиция, состояние».
          - { id: m6.div.2, type: frame, size: [ fill, 1 ], fill: $border }
          - id: m6.sec.rule
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 4 }
            children:
              - {
                  id: m6.sec.rule.label,
                  type: text,
                  size: [ hug, hug ],
                  content: Rule,
                  fontSize: 12,
                  fontWeight: 600,
                  color: $text.secondary
                }
              - {
                  id: m6.sec.rule.text,
                  type: text,
                  size: [ fill, hug ],
                  content: "Устойчивая коллокация «существительное + существительное»: ударение на
                    первом слове.",
                  fontSize: 13,
                  lineHeight: 19,
                  color: $text.primary
                }
          - { id: m6.div.3, type: frame, size: [ fill, 1 ], fill: $border }
          - id: m6.sec.usage
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 4 }
            children:
              - {
                  id: m6.sec.usage.label,
                  type: text,
                  size: [ hug, hug ],
                  content: How to use it,
                  fontSize: 12,
                  fontWeight: 600,
                  color: $text.secondary
                }
              - {
                  id: m6.sec.usage.text,
                  type: text,
                  size: [ fill, hug ],
                  content: "Regular audits help maintain a strong security posture.",
                  fontSize: 13,
                  lineHeight: 19,
                  color: $text.primary
                }
          - { id: m6.spacer, type: frame, size: [ fill, fill ] }
          - id: m6.ask
            type: frame
            size: [ fill, 40 ]
            cornerRadius: 8
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              {
                type: flex,
                direction: row,
                gap: 6,
