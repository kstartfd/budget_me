          {
            type: flex,
            direction: row,
            justifyContent: spaceBetween,
            alignItems: center,
            padding: [ 12, 16 ]
          }
        children:
          - id: m5.back
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, direction: row, gap: 6, alignItems: center }
            children:
              - {
                  id: m5.back.icon,
