            type: frame
            size: [ fill, 38 ]
            cornerRadius: 8
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              {
                type: flex,
                direction: row,
                gap: 8,
                alignItems: center,
                padding: [ 0, 12 ]
              }
            children:
              - {
                  id: m7.search.icon,
                  type: svg,
                  size: [ 12, 12 ],
                  icon: fas:magnifying-glass,
                  fill: $text.tertiary
                }
              - {
                  id: m7.search.placeholder,
                  type: text,
                  size: [ hug, hug ],
                  content: Find a word or phrase,
                  fontSize: 12,
                  color: $text.tertiary
                }
      - id: m7.actions
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: row, gap: 8, padding: [ 0, 16, 10, 16 ] }
        children:
          - id: m7.fromPhoto
            type: frame
            size: [ fill, 36 ]
            cornerRadius: 8
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              {
                type: flex,
                direction: row,
                gap: 6,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m7.fromPhoto.icon,
                  type: svg,
                  size: [ 12, 12 ],
                  icon: fas:camera,
                  fill: $text.primary
                }
              - {
                  id: m7.fromPhoto.text,
                  type: text,
                  size: [ hug, hug ],
                  content: From photo,
                  fontSize: 12,
                  fontWeight: 500,
                  color: $text.primary
                }
          - id: m7.add
            type: frame
            size: [ fill, 36 ]
            cornerRadius: 8
            fill: $primary
            layout:
              {
                type: flex,
                direction: row,
                gap: 6,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m7.add.icon,
                  type: svg,
                  size: [ 11, 11 ],
                  icon: fas:plus,
                  fill: "#FFFFFF"
                }
              - {
                  id: m7.add.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Add entry,
                  fontSize: 12,
                  fontWeight: 500,
                  color: "#FFFFFF"
                }
      - id: m7.list
        type: frame
        size: [ fill, fill ]
        layout: { type: flex, direction: column, padding: [ 0, 16 ], alignItems: start }
        children:
          - id: m7.list.card
            type: frame
            size: [ fill, hug ]
            cornerRadius: 12
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              type: flex
              direction: column
              overflow: hidden
            children:
              - id: m7.entry.1
                type: frame
                size: [ fill, hug ]
                stroke: { color: $border, width: [ 0, 0, 1, 0 ], alignment: inside }
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 12, 12 ]
                  }
                children:
                  - { id: m7.entry.1.dot, type: ellipse, size: [ 8, 8 ], fill: "#D97706" }
                  - id: m7.entry.1.body
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m7.entry.1.term,
                          type: text,
                          size: [ fill, hug ],
                          content: security posture,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.1.translation,
                          type: text,
                          size: [ fill, hug ],
                          content: "состояние защищённости",
                          fontSize: 12,
                          color: $text.secondary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.1.meta,
                          type: text,
                          size: [ fill, hug ],
                          content: "Phrase · Inbox · PortSwigger",
                          fontSize: 10,
                          color: $text.tertiary,
                          maxLines: 1
                        }
                  - {
                      id: m7.entry.1.sound,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: fas:volume-high,
                      fill: $text.tertiary
                    }
                  - {
                      id: m7.entry.1.chevron,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:chevron-right,
                      fill: $text.tertiary
                    }
              - id: m7.entry.2
                type: frame
                size: [ fill, hug ]
                stroke: { color: $border, width: [ 0, 0, 1, 0 ], alignment: inside }
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 12, 12 ]
                  }
                children:
                  - { id: m7.entry.2.dot, type: ellipse, size: [ 8, 8 ], fill: "#D97706" }
                  - id: m7.entry.2.body
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m7.entry.2.term,
                          type: text,
                          size: [ fill, hug ],
                          content: a weaker security posture,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.2.translation,
                          type: text,
                          size: [ fill, hug ],
                          content: "защищённость слабее",
                          fontSize: 12,
                          color: $text.secondary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.2.meta,
                          type: text,
                          size: [ fill, hug ],
                          content: "Phrase · Inbox · PortSwigger",
                          fontSize: 10,
                          color: $text.tertiary,
                          maxLines: 1
                        }
                  - {
                      id: m7.entry.2.sound,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: fas:volume-high,
                      fill: $text.tertiary
                    }
                  - {
                      id: m7.entry.2.chevron,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:chevron-right,
                      fill: $text.tertiary
                    }
              - id: m7.entry.3
                type: frame
                size: [ fill, hug ]
                stroke: { color: $border, width: [ 0, 0, 1, 0 ], alignment: inside }
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 12, 12 ]
                  }
                children:
                  - { id: m7.entry.3.dot, type: ellipse, size: [ 8, 8 ], fill: "#D97706" }
                  - id: m7.entry.3.body
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m7.entry.3.term,
                          type: text,
                          size: [ fill, hug ],
                          content: posture,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.3.translation,
                          type: text,
                          size: [ fill, hug ],
                          content: "осанка; поза; позиция",
                          fontSize: 12,
                          color: $text.secondary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.3.meta,
                          type: text,
                          size: [ fill, hug ],
                          content: "Word · Inbox · PortSwigger",
                          fontSize: 10,
                          color: $text.tertiary,
                          maxLines: 1
                        }
                  - {
                      id: m7.entry.3.sound,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: fas:volume-high,
                      fill: $text.tertiary
                    }
                  - {
                      id: m7.entry.3.chevron,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:chevron-right,
                      fill: $text.tertiary
                    }
              - id: m7.entry.4
                type: frame
                size: [ fill, hug ]
                stroke: { color: $border, width: [ 0, 0, 1, 0 ], alignment: inside }
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 12, 12 ]
                  }
                children:
                  - { id: m7.entry.4.dot, type: ellipse, size: [ 8, 8 ], fill: "#D97706" }
                  - id: m7.entry.4.body
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m7.entry.4.term,
                          type: text,
                          size: [ fill, hug ],
                          content: weaker,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.4.translation,
                          type: text,
                          size: [ fill, hug ],
                          content: "слабее",
                          fontSize: 12,
                          color: $text.secondary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.4.meta,
                          type: text,
                          size: [ fill, hug ],
                          content: "Word · Inbox · PortSwigger",
                          fontSize: 10,
                          color: $text.tertiary,
                          maxLines: 1
                        }
                  - {
                      id: m7.entry.4.sound,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: fas:volume-high,
                      fill: $text.tertiary
                    }
                  - {
                      id: m7.entry.4.chevron,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:chevron-right,
                      fill: $text.tertiary
                    }
              - id: m7.entry.5
                type: frame
                size: [ fill, hug ]
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 12, 12 ]
                  }
                children:
                  - { id: m7.entry.5.dot, type: ellipse, size: [ 8, 8 ], fill: "#D97706" }
                  - id: m7.entry.5.body
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m7.entry.5.term,
                          type: text,
                          size: [ fill, hug ],
                          content: ordinary,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.5.translation,
                          type: text,
                          size: [ fill, hug ],
                          content: "обычный",
                          fontSize: 12,
                          color: $text.secondary,
                          maxLines: 1
                        }
                      - {
                          id: m7.entry.5.meta,
                          type: text,
                          size: [ fill, hug ],
                          content: "Word · Inbox",
                          fontSize: 10,
                          color: $text.tertiary,
                          maxLines: 1
                        }
                  - {
                      id: m7.entry.5.sound,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: fas:volume-high,
                      fill: $text.tertiary
                    }
                  - {
                      id: m7.entry.5.chevron,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:chevron-right,
                      fill: $text.tertiary
                    }
      - id: m7.tabs
        type: frame
        size: [ fill, 62 ]
        fill: $bg
        stroke: { color: $border, width: [ 1, 0, 0, 0 ], alignment: inside }
        layout: { type: flex, direction: row, padding: [ 6, 8, 14, 8 ] }
        children:
          - id: m7.tab.topics
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m7.tab.topics.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:layer-group,
                  fill: $text.primary
                }
              - {
                  id: m7.tab.topics.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Topics,
                  fontSize: 10,
                  fontWeight: 600,
                  color: $text.primary
                }
          - id: m7.tab.teacher
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m7.tab.teacher.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:chalkboard-user,
                  fill: $text.tertiary
                }
              - {
                  id: m7.tab.teacher.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Teacher,
                  fontSize: 10,
                  fontWeight: 500,
                  color: $text.tertiary
                }
          - id: m7.tab.chat
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m7.tab.chat.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:comment-dots,
                  fill: $text.tertiary
                }
              - {
                  id: m7.tab.chat.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Chat,
                  fontSize: 10,
                  fontWeight: 500,
                  color: $text.tertiary
                }
          - id: m7.tab.settings
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m7.tab.settings.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:gear,
                  fill: $text.tertiary
                }
              - {
                  id: m7.tab.settings.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Settings,
                  fontSize: 10,
                  fontWeight: 500,
                  color: $text.tertiary
                }

      - id: m7.scrim
        type: rect
        position: [ 0, 0 ]
        size: [ fill, fill ]
        fill: "#09090B80"
      - id: m7.sheet
        type: frame
        position: [ 0, 324 ]
        size: [ 390, 520 ]
        cornerRadius: 16
        fill: $bg
        effects: { type: shadow, color: "#00000026", offset: [ 0, -4 ], blur: 24 }
        layout: { type: flex, direction: column, gap: 12, padding: [ 12, 20, 20, 20 ] }
        children:
          - id: m7.sheet.grabberRow
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: center }
            children:
              - {
                  id: m7.sheet.grabber,
                  type: rect,
                  size: [ 36, 4 ],
                  cornerRadius: 2,
                  fill: $border
                }
          - id: m7.sheet.head
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                justifyContent: spaceBetween,
                alignItems: center
              }
            children:
              - {
                  id: m7.sheet.title,
                  type: text,
                  size: [ hug, hug ],
                  content: Add entry,
                  fontSize: 17,
                  fontWeight: 600,
                  color: $text.primary
                }
              - id: m7.close
                type: frame
                size: [ 28, 28 ]
                cornerRadius: 6
                fill: $muted
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m7.close.icon,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: fas:xmark,
                      fill: $text.secondary
                    }
          - {
              id: m7.sheet.desc,
              type: text,
              size: [ fill, hug ],
              content: A word or phrase is enough. Add a translation and explanations later.,
              fontSize: 12,
              color: $text.secondary
            }
          - id: m7.sheet.kind
            type: frame
            size: [ fill, 34 ]
            cornerRadius: 8
            fill: $muted
            layout: { type: flex, direction: row, padding: 3, gap: 2 }
            children:
              - id: m7.kind.word
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m7.kind.word.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Word,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: m7.kind.phrase
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                fill: $bg
                effects: { type: shadow, color: "#0000000F", offset: [ 0, 1 ], blur: 2 }
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m7.kind.phrase.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Phrase,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.primary
                    }
          - id: m7.f.term
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 4 }
            children:
              - {
                  id: m7.f.term.label,
                  type: text,
                  size: [ hug, hug ],
                  content: Word or phrase,
                  fontSize: 12,
                  fontWeight: 500,
                  color: $text.primary
                }
              - id: m7.f.term.input
                type: frame
                size: [ fill, 44 ]
                cornerRadius: 8
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                children:
                  - {
                      id: m7.f.term.placeholder,
                      type: text,
                      size: [ hug, hug ],
                      content: "For example, hit the road",
                      fontSize: 13,
                      color: $text.tertiary
                    }
          - id: m7.f.translation
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 4 }
            children:
              - {
                  id: m7.f.translation.label,
                  type: text,
                  size: [ hug, hug ],
                  content: Translation,
                  fontSize: 12,
                  fontWeight: 500,
                  color: $text.primary
                }
              - id: m7.f.translation.input
                type: frame
                size: [ fill, 44 ]
                cornerRadius: 8
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                children:
                  - {
                      id: m7.f.translation.placeholder,
                      type: text,
                      size: [ hug, hug ],
                      content: What it means,
                      fontSize: 13,
                      color: $text.tertiary
                    }
          - id: m7.f.source
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 4 }
            children:
              - {
                  id: m7.f.source.label,
                  type: text,
                  size: [ hug, hug ],
                  content: Source,
                  fontSize: 12,
                  fontWeight: 500,
                  color: $text.primary
                }
              - id: m7.f.source.input
                type: frame
                size: [ fill, 44 ]
                cornerRadius: 8
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                children:
                  - {
                      id: m7.f.source.placeholder,
                      type: text,
                      size: [ hug, hug ],
                      content: "Video, episode, speaker and timestamp",
                      fontSize: 13,
                      color: $text.tertiary
                    }
          - id: m7.status
            type: frame
            size: [ fill, 36 ]
            cornerRadius: 8
            fill: $muted
            layout: { type: flex, direction: row, padding: 3, gap: 2 }
            children:
              - id: m7.status.inbox
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m7.status.inbox.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Inbox,
                      fontSize: 12,
                      fontWeight: 500,
                      color: "#FFFFFF"
                    }
              - id: m7.status.learning
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m7.status.learning.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Learning,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: m7.status.known
                type: frame
                size: [ fill, fill ]
                cornerRadius: 6
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m7.status.known.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Known,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.secondary
                    }
          - id: m7.save
            type: frame
            size: [ fill, 44 ]
            cornerRadius: 8
            fill: $primary
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: m7.save.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Save,
                  fontSize: 14,
                  fontWeight: 500,
                  color: "#FFFFFF"
                }

prototype: |
  flow main = "m.start" {
    viewport: [390, 844]
  }

  on click("m1.card.beginner") {
    navigate("m.lesson", transition: none())
  }

  on click("m1.card.chat") {
    navigate("m.lesson", transition: none())
  }

  on click("m1.card.check") {
    navigate("m.lesson", transition: none())
  }

  on click("m1.card.grammar") {
    navigate("m.lesson", transition: none())
  }

  on click("m1.tab.topics") {
    navigate("m.topics", transition: none())
  }

  on click("m1.tab.teacher") {
    navigate("m.teacher", transition: none())
  }

  on click("m2.back") {
    back(transition: none())
  }

  on click("m2.tab.topics") {
    navigate("m.topics", transition: none())
  }

  on click("m2.tab.teacher") {
    navigate("m.teacher", transition: none())
  }

  on click("m3.tab.chat") {
    navigate("m.start", transition: none())
  }

  on click("m3.tab.teacher") {
    navigate("m.teacher", transition: none())
  }

  on click("m3.topic.1") {
    navigate("m.vocab", transition: none())
  }

  on click("m4.tab.topics") {
    navigate("m.topics", transition: none())
  }

  on click("m4.tab.chat") {
    navigate("m.start", transition: none())
  }

  on click("m5.back") {
    navigate("m.topics", transition: none())
  }

  on click("m5.entry.1") {
    navigate("m.entry", transition: none())
  }

  on click("m5.add") {
    navigate("m.addentry", transition: dissolve(180))
  }

  on click("m5.tab.chat") {
    navigate("m.start", transition: none())
  }

  on click("m5.tab.teacher") {
    navigate("m.teacher", transition: none())
  }

  on click("m6.back") {
    back(transition: none())
  }

  on click("m6.tab.chat") {
    navigate("m.start", transition: none())
  }

  on click("m6.tab.topics") {
    navigate("m.topics", transition: none())
  }

  on click("m6.tab.teacher") {
    navigate("m.teacher", transition: none())
  }

  on click("m7.close") {
    back(transition: dissolve(150))
  }

  on click("m7.save") {
    back(transition: dissolve(150))
  }
