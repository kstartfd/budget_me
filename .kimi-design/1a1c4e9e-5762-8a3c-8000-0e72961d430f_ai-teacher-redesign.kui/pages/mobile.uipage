name: AI Teacher Mobile

children:
  - id: note.m1
    type: text
    position: [ 40, 24 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 700
    color: "#000000"
    content: Chat

  - id: m.start
    type: frame
    position: [ 40, 88 ]
    size: [ 390, 844 ]
    fill: $bg
    layout:
      type: flex
      direction: column
      overflow: hidden
    children:
      - id: m1.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            justifyContent: spaceBetween,
            alignItems: center,
            padding: [ 14, 16 ]
          }
        children:
          - id: m1.header.left
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, direction: row, gap: 10, alignItems: center }
            children:
              - id: m1.logo.mark
                type: frame
                size: [ 28, 28 ]
                cornerRadius: 6
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m1.logo.icon,
                      type: svg,
                      size: [ 13, 13 ],
                      icon: fas:graduation-cap,
                      fill: "#FFFFFF"
                    }
              - {
                  id: m1.logo.text,
                  type: text,
                  size: [ hug, hug ],
                  content: AI Teacher,
                  fontSize: 17,
                  fontWeight: 600,
                  letterSpacing: -0.3,
                  color: $text.primary
                }
          - id: m1.header.actions
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, direction: row, gap: 8 }
            children:
              - id: m1.header.lang
                type: frame
                size: [ 34, 34 ]
                cornerRadius: 6
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m1.header.lang.icon,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:globe,
                      fill: $text.secondary
                    }
              - id: m1.header.history
                type: frame
                size: [ 34, 34 ]
                cornerRadius: 6
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m1.header.history.icon,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:clock-rotate-left,
                      fill: $text.secondary
                    }
      - id: m1.hero
        type: frame
        size: [ fill, fill ]
        layout:
          {
            type: flex,
            direction: column,
            alignItems: center,
            justifyContent: center,
            padding: [ 0, 24 ]
          }
        children:
          - id: m1.hero.icon
            type: frame
            size: [ 44, 44 ]
            cornerRadius: 10
            fill: $muted
            margin: [ 0, 0, 14, 0 ]
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: m1.hero.icon.svg,
                  type: svg,
                  size: [ 20, 20 ],
                  icon: fas:graduation-cap,
                  fill: $text.primary
                }
          - {
              id: m1.hero.title,
              type: text,
              size: [ hug, hug ],
              content: Let's start a lesson,
              fontSize: 22,
              fontWeight: 600,
              letterSpacing: -0.4,
              color: $text.primary,
              margin: [ 0, 0, 6, 0 ]
            }
          - {
              id: m1.hero.subtitle,
              type: text,
              size: [ 280, hug ],
              content: Write anything or pick a way to begin. The teacher finds your level and
                leads the lesson.,
              fontSize: 13,
              lineHeight: 19,
              align: [ center, top ],
              color: $text.secondary,
              margin: [ 0, 0, 20, 0 ]
            }
          - id: m1.hero.cards
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 8 }
            children:
              - id: m1.card.beginner
                type: frame
                size: [ fill, hug ]
                cornerRadius: 10
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, direction: row, gap: 10, alignItems: center, padding: 12 }
                children:
                  - id: m1.card.beginner.icon
                    type: frame
                    size: [ 32, 32 ]
                    cornerRadius: 6
                    fill: $muted
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: m1.card.beginner.icon.svg,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: fas:seedling,
                          fill: $text.primary
                        }
                  - id: m1.card.beginner.text
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m1.card.beginner.title,
                          type: text,
                          size: [ hug, hug ],
                          content: I'm a beginner,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary
                        }
                      - {
                          id: m1.card.beginner.desc,
                          type: text,
                          size: [ fill, hug ],
                          content: Start with the basics,
                          fontSize: 11,
                          color: $text.secondary
                        }
              - id: m1.card.chat
                type: frame
                size: [ fill, hug ]
                cornerRadius: 10
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, direction: row, gap: 10, alignItems: center, padding: 12 }
                children:
                  - id: m1.card.chat.icon
                    type: frame
                    size: [ 32, 32 ]
                    cornerRadius: 6
                    fill: $muted
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: m1.card.chat.icon.svg,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: fas:comments,
                          fill: $text.primary
                        }
                  - id: m1.card.chat.text
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m1.card.chat.title,
                          type: text,
                          size: [ hug, hug ],
                          content: Let's just chat,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary
                        }
                      - {
                          id: m1.card.chat.desc,
                          type: text,
                          size: [ fill, hug ],
                          content: Casual conversation on any topic,
                          fontSize: 11,
                          color: $text.secondary
                        }
              - id: m1.card.check
                type: frame
                size: [ fill, hug ]
                cornerRadius: 10
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, direction: row, gap: 10, alignItems: center, padding: 12 }
                children:
                  - id: m1.card.check.icon
                    type: frame
                    size: [ 32, 32 ]
                    cornerRadius: 6
                    fill: $muted
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: m1.card.check.icon.svg,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: fas:spell-check,
                          fill: $text.primary
                        }
                  - id: m1.card.check.text
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m1.card.check.title,
                          type: text,
                          size: [ hug, hug ],
                          content: Check my sentences,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary
                        }
                      - {
                          id: m1.card.check.desc,
                          type: text,
                          size: [ fill, hug ],
                          content: Corrections with clear explanations,
                          fontSize: 11,
                          color: $text.secondary
                        }
              - id: m1.card.grammar
                type: frame
                size: [ fill, hug ]
                cornerRadius: 10
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, direction: row, gap: 10, alignItems: center, padding: 12 }
                children:
                  - id: m1.card.grammar.icon
                    type: frame
                    size: [ 32, 32 ]
                    cornerRadius: 6
                    fill: $muted
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: m1.card.grammar.icon.svg,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: fas:book-open,
                          fill: $text.primary
                        }
                  - id: m1.card.grammar.text
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 1 }
                    children:
                      - {
                          id: m1.card.grammar.title,
                          type: text,
                          size: [ hug, hug ],
                          content: Go through grammar,
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary
                        }
                      - {
                          id: m1.card.grammar.desc,
                          type: text,
                          size: [ fill, hug ],
                          content: Structured practice with rules,
                          fontSize: 11,
                          color: $text.secondary
                        }
      - id: m1.composer
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, padding: [ 10, 12 ] }
        children:
          - id: m1.composer.bar
            type: frame
            size: [ fill, 46 ]
            cornerRadius: 10
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              {
                type: flex,
                direction: row,
                alignItems: center,
                gap: 6,
                padding: [ 0, 6, 0, 14 ]
              }
            children:
              - {
                  id: m1.composer.placeholder,
                  type: text,
                  size: [ fill, hug ],
                  content: Write a message...,
                  fontSize: 14,
                  color: $text.tertiary
                }
              - id: m1.composer.mic
                type: frame
                size: [ 34, 34 ]
                cornerRadius: 8
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m1.composer.mic.icon,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:microphone,
                      fill: $text.secondary
                    }
              - id: m1.composer.send
                type: frame
                size: [ 34, 34 ]
                cornerRadius: 8
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m1.composer.send.icon,
                      type: svg,
                      size: [ 13, 13 ],
                      icon: fas:arrow-up,
                      fill: "#FFFFFF"
                    }
      - id: m1.tabs
        type: frame
        size: [ fill, 62 ]
        fill: $bg
        stroke: { color: $border, width: [ 1, 0, 0, 0 ], alignment: inside }
        layout: { type: flex, direction: row, padding: [ 6, 8, 14, 8 ] }
        children:
          - id: m1.tab.topics
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m1.tab.topics.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:layer-group,
                  fill: $text.tertiary
                }
              - {
                  id: m1.tab.topics.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Topics,
                  fontSize: 10,
                  fontWeight: 500,
                  color: $text.tertiary
                }
          - id: m1.tab.teacher
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m1.tab.teacher.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:chalkboard-user,
                  fill: $text.tertiary
                }
              - {
                  id: m1.tab.teacher.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Teacher,
                  fontSize: 10,
                  fontWeight: 500,
                  color: $text.tertiary
                }
          - id: m1.tab.chat
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m1.tab.chat.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:comment-dots,
                  fill: $text.primary
                }
              - {
                  id: m1.tab.chat.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Chat,
                  fontSize: 10,
                  fontWeight: 600,
                  color: $text.primary
                }
          - id: m1.tab.settings
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                gap: 4,
                alignItems: center,
                justifyContent: center
              }
            children:
              - {
                  id: m1.tab.settings.icon,
                  type: svg,
                  size: [ 18, 18 ],
                  icon: fas:gear,
                  fill: $text.tertiary
                }
              - {
                  id: m1.tab.settings.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Settings,
                  fontSize: 10,
                  fontWeight: 500,
                  color: $text.tertiary
                }

  - id: note.m2
    type: text
    position: [ 510, 24 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 700
    color: "#000000"
    content: Lesson

  - id: m.lesson
    type: frame
    position: [ 510, 88 ]
    size: [ 390, 844 ]
    fill: $bg
    layout:
      type: flex
      direction: column
      overflow: hidden
    children:
      - id: m2.header
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 10,
            alignItems: center,
            padding: [ 12, 16 ]
          }
        children:
          - id: m2.back
            type: frame
            size: [ 34, 34 ]
            cornerRadius: 6
            stroke: { color: $border, width: 1, alignment: inside }
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: m2.back.icon,
                  type: svg,
                  size: [ 13, 13 ],
                  icon: fas:chevron-left,
                  fill: $text.primary
                }
          - id: m2.header.texts
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 1 }
            children:
              - {
                  id: m2.header.title,
                  type: text,
                  size: [ hug, hug ],
                  content: AI Teacher,
                  fontSize: 15,
                  fontWeight: 600,
                  color: $text.primary
                }
              - {
                  id: m2.header.subtitle,
                  type: text,
                  size: [ hug, hug ],
                  content: Lesson 4 · Talking about the weekend,
                  fontSize: 11,
                  color: $text.tertiary
                }
          - id: m2.header.history
            type: frame
            size: [ 34, 34 ]
            cornerRadius: 6
            stroke: { color: $border, width: 1, alignment: inside }
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: m2.header.history.icon,
                  type: svg,
                  size: [ 13, 13 ],
                  icon: fas:clock-rotate-left,
                  fill: $text.secondary
                }
      - id: m2.chat
        type: frame
        size: [ fill, fill ]
        layout:
          {
            type: flex,
            direction: column,
            justifyContent: end,
            gap: 12,
            padding: [ 8, 16 ]
          }
        children:
          - id: m2.msg.t1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 8, alignItems: start }
            children:
              - id: m2.msg.t1.avatar
                type: frame
                size: [ 22, 22 ]
                cornerRadius: 11
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m2.msg.t1.avatar.icon,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:graduation-cap,
                      fill: "#FFFFFF"
                    }
              - id: m2.msg.t1.bubble
                type: frame
                size: [ 300, hug ]
                cornerRadius: 12
                fill: $muted
                layout: { type: flex, padding: [ 10, 12 ] }
                children:
                  - {
                      id: m2.msg.t1.text,
                      type: text,
                      size: [ 276, hug ],
                      content: "Hi Alex! Let's warm up. Tell me about your last weekend. What did you
                        do?",
                      fontSize: 13,
                      lineHeight: 18,
                      color: $text.primary
                    }
          - id: m2.msg.u1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, justifyContent: end }
            children:
              - id: m2.msg.u1.bubble
                type: frame
                size: [ 300, hug ]
                cornerRadius: 12
                fill: $primary
                layout: { type: flex, padding: [ 10, 12 ] }
                children:
                  - {
                      id: m2.msg.u1.text,
                      type: text,
                      size: [ 276, hug ],
                      content: "I go to the cinema with my friends on Saturday. We watch a new film.",
                      fontSize: 13,
                      lineHeight: 18,
                      color: "#FFFFFF"
                    }
          - id: m2.msg.c1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 8, alignItems: start }
            children:
              - id: m2.msg.c1.avatar
                type: frame
                size: [ 22, 22 ]
                cornerRadius: 11
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m2.msg.c1.avatar.icon,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:graduation-cap,
                      fill: "#FFFFFF"
                    }
              - id: m2.msg.c1.card
                type: frame
                size: [ fill, hug ]
                cornerRadius: 12
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, direction: column, gap: 8, padding: 12 }
                children:
                  - id: m2.c1.badge
                    type: frame
                    size: [ hug, hug ]
                    cornerRadius: 6
                    fill: $muted
                    layout:
                      {
                        type: flex,
                        direction: row,
                        gap: 5,
                        alignItems: center,
                        padding: [ 3, 8 ]
                      }
                    children:
                      - {
                          id: m2.c1.badge.icon,
                          type: svg,
                          size: [ 10, 10 ],
                          icon: fas:pencil,
                          fill: $text.primary
                        }
                      - {
                          id: m2.c1.badge.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Correction,
                          fontSize: 11,
                          fontWeight: 600,
                          color: $text.primary
                        }
                  - id: m2.c1.wrong
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: row, gap: 8, alignItems: start }
                    children:
                      - {
                          id: m2.c1.wrong.icon,
                          type: svg,
                          size: [ 10, 10 ],
                          icon: fas:xmark,
                          fill: $destructive,
                          margin: [ 4, 0, 0, 0 ]
                        }
                      - id: m2.c1.wrong.text
                        type: text
                        size: [ 286, hug ]
                        fontSize: 13
                        lineHeight: 18
                        color: $text.secondary
                        content: |
                          I <s>go</s> to the cinema with my friends on Saturday. We <s>watch</s> a new film.
                  - id: m2.c1.right
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: row, gap: 8, alignItems: start }
                    children:
                      - {
                          id: m2.c1.right.icon,
                          type: svg,
                          size: [ 10, 10 ],
                          icon: fas:check,
                          fill: $success,
                          margin: [ 4, 0, 0, 0 ]
                        }
                      - id: m2.c1.right.text
                        type: text
                        size: [ 286, hug ]
                        fontSize: 13
                        lineHeight: 18
                        color: $text.primary
                        content: |
                          I <strong>went</strong> to the cinema with my friends on Saturday. We <strong>watched</strong> a new film.
                  - {
                      id: m2.c1.why,
                      type: text,
                      size: [ 304, hug ],
                      content: "Both actions finished in the past, so use Past Simple: go → went,
                        watch → watched.",
                      fontSize: 12,
                      lineHeight: 17,
                      color: $text.secondary
                    }
                  - id: m2.c1.actions
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: row, alignItems: center }
                    children:
                      - {
                          id: m2.c1.whyLink,
                          type: text,
                          size: [ hug, hug ],
                          content: Why?,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.primary,
                          decoration: underline
                        }
                      - { id: m2.c1.spacer, type: frame, size: [ fill, 1 ] }
                      - id: m2.c1.tryAgain
                        type: frame
                        size: [ hug, 28 ]
                        cornerRadius: 6
                        stroke: { color: $border, width: 1, alignment: inside }
                        layout:
                          {
                            type: flex,
                            direction: row,
                            gap: 5,
                            alignItems: center,
                            padding: [ 0, 10 ]
                          }
                        children:
                          - {
                              id: m2.c1.tryAgain.icon,
                              type: svg,
                              size: [ 10, 10 ],
                              icon: fas:rotate-left,
                              fill: $text.primary
                            }
                          - {
                              id: m2.c1.tryAgain.text,
                              type: text,
                              size: [ hug, hug ],
                              content: Try again,
                              fontSize: 11,
                              fontWeight: 500,
                              color: $text.primary
                            }
          - id: m2.msg.t2
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: row, gap: 8, alignItems: start }
            children:
              - id: m2.msg.t2.avatar
                type: frame
                size: [ 22, 22 ]
                cornerRadius: 11
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m2.msg.t2.avatar.icon,
                      type: svg,
                      size: [ 10, 10 ],
                      icon: fas:graduation-cap,
                      fill: "#FFFFFF"
                    }
              - id: m2.msg.t2.bubble
                type: frame
                size: [ 300, hug ]
                cornerRadius: 12
                fill: $muted
                layout: { type: flex, padding: [ 10, 12 ] }
                children:
                  - {
                      id: m2.msg.t2.text,
                      type: text,
                      size: [ 276, hug ],
                      content: "Exactly. What was the film about?",
                      fontSize: 13,
                      lineHeight: 18,
                      color: $text.primary
                    }
      - id: m2.composer
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, padding: [ 10, 12 ] }
        children:
          - id: m2.composer.bar
            type: frame
            size: [ fill, 46 ]
            cornerRadius: 10
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              {
                type: flex,
                direction: row,
                alignItems: center,
                gap: 6,
                padding: [ 0, 6, 0, 14 ]
              }
            children:
              - {
                  id: m2.composer.placeholder,
                  type: text,
                  size: [ fill, hug ],
                  content: Write a message...,
                  fontSize: 14,
                  color: $text.tertiary
                }
              - id: m2.composer.mic
                type: frame
                size: [ 34, 34 ]
                cornerRadius: 8
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: m2.composer.mic.icon,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:microphone,
                      fill: $text.secondary
                    }
              - id: m2.composer.send
