            size: [ fill, 32 ]
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: m6.delete.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Delete entry,
                  fontSize: 13,
                  fontWeight: 500,
                  color: $destructive
                }
      - id: m6.tabs
        type: frame
        size: [ fill, 62 ]
        fill: $bg
        stroke: { color: $border, width: [ 1, 0, 0, 0 ], alignment: inside }
        layout: { type: flex, direction: row, padding: [ 6, 8, 14, 8 ] }
