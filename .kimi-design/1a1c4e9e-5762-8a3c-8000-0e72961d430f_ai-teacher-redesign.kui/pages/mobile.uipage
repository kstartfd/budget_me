                  icon: fas:comment,
                  fill: $text.primary
                }
              - {
                  id: m6.ask.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Ask the AI agent,
                  fontSize: 13,
                  fontWeight: 500,
                  color: $text.primary
                }
          - id: m6.delete
