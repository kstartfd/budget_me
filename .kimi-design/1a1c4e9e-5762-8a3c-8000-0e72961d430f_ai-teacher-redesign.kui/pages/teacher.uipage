        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            gap: 8,
            alignItems: center,
            padding: [ 20, 32, 16, 32 ]
          }
        children:
          - id: vocab.tabs.status
            type: frame
            size: [ hug, 36 ]
            cornerRadius: 6
            fill: $muted
            layout: { type: flex, direction: row, padding: 4, gap: 2 }
            children:
              - id: vtab.all
                type: frame
                size: [ hug, fill ]
                cornerRadius: 4
                fill: $bg
                effects: { type: shadow, color: "#0000000F", offset: [ 0, 1 ], blur: 2 }
