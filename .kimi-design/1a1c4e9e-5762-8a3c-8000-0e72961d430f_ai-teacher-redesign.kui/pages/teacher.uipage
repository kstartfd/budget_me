                    children:
                      - {
                          id: ae.status.inbox.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Inbox,
                          fontSize: 12,
                          fontWeight: 500,
                          color: "#FFFFFF"
                        }
                  - id: ae.status.learning
                    type: frame
                    size: [ hug, 28 ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                    children:
                      - {
                          id: ae.status.learning.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Learning,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.primary
                        }
                  - id: ae.status.known
                    type: frame
                    size: [ hug, 28 ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                    children:
                      - {
                          id: ae.status.known.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Known,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.primary
                        }
              - id: ae.detail.sep.1
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: ae.detail.breakdown
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - {
                      id: ae.detail.breakdown.label,
                      type: text,
                      size: [ hug, hug ],
                      margin: [ 12, 0, 0, 0 ],
                      content: Breakdown,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.tertiary
                    }
                  - id: ae.detail.breakdown.text
                    type: text
                    size: [ fill, hug ]
                    fontSize: 13
                    lineHeight: 20
                    color: $text.primary
                    content: |
                      <p><strong>security</strong> — «безопасность», здесь в значении защищённости от атак, а не охраны. В ИТ-контексте устойчиво переводится как «защита / безопасность» системы.</p>
                      <p style="margin-top:8px;"><strong>posture</strong> — многозначное: буквально «осанка, поза»; переносно — «позиция, установка, общее состояние». В связке с security даёт смысл «общая готовность к защите», то есть совокупное состояние defences, а не конкретный механизм.</p>
              - id: ae.detail.sep.2
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: ae.detail.rule
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - {
                      id: ae.detail.rule.label,
                      type: text,
                      size: [ hug, hug ],
                      margin: [ 12, 0, 0, 0 ],
                      content: Rule,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.tertiary
                    }
                  - {
                      id: ae.detail.rule.text,
                      type: text,
                      size: [ fill, hug ],
                      fontSize: 13,
                      lineHeight: 20,
                      color: $text.primary,
                      content: "Устойчивая коллокация «существительное + существительное»: первое
                        слово определяет второе. Аналогично: defence posture —
                        «оборонительная позиция»."
                    }
              - id: ae.detail.sep.3
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: ae.detail.example
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - {
                      id: ae.detail.example.label,
                      type: text,
                      size: [ hug, hug ],
                      margin: [ 12, 0, 0, 0 ],
                      content: How to use it,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.tertiary
                    }
                  - {
                      id: ae.detail.example.text,
                      type: text,
                      size: [ fill, hug ],
                      fontSize: 13,
                      lineHeight: 20,
                      color: $text.primary,
                      content: "Regular audits help maintain a strong security posture. — Регулярные
                        аудиты помогают поддерживать высокий уровень
                        защищённости."
                    }
              - id: ae.detail.sep.4
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: ae.detail.actions
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: row, alignItems: center, gap: 8 }
                children:
                  - id: ae.button.askAI
                    type: frame
                    size: [ hug, 32 ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    margin: [ 12, 0, 0, 0 ]
                    layout:
                      {
                        type: flex,
                        direction: row,
                        gap: 6,
                        alignItems: center,
                        padding: [ 0, 12 ]
                      }
                    children:
                      - {
                          id: ae.button.askAI.icon,
                          type: svg,
                          size: [ 11, 11 ],
                          icon: fas:comment-dots,
                          fill: $text.primary
                        }
                      - {
                          id: ae.button.askAI.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Ask the AI agent,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.primary
                        }
                  - id: ae.detail.actions.spacer
                    type: frame
                    size: [ fill, 1 ]
                  - id: ae.button.deleteEntry
                    type: frame
                    size: [ hug, 32 ]
                    cornerRadius: 6
                    margin: [ 12, 0, 0, 0 ]
                    layout:
                      {
                        type: flex,
                        direction: row,
                        gap: 6,
                        alignItems: center,
                        padding: [ 0, 12 ]
                      }
                    children:
                      - {
                          id: ae.button.deleteEntry.icon,
                          type: svg,
                          size: [ 11, 11 ],
                          icon: fas:trash,
                          fill: $destructive
                        }
                      - {
                          id: ae.button.deleteEntry.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Delete entry,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $destructive
                        }
      - id: ae.overlay.scrim
        type: rect
        position: [ 0, 0 ]
        size: [ fill, fill ]
        fill: "#09090B99"
      - id: ae.overlay.addEntry
        type: frame
        position: [ 420, 120 ]
        size: [ 600, hug ]
        cornerRadius: 10
        fill: $bg
        stroke: { color: $border, width: 1, alignment: inside }
        effects: { type: shadow, color: "#0000001A", offset: [ 0, 10 ], blur: 30 }
        layout:
          type: flex
          direction: column
          gap: 12
          padding: 24
        children:
          - id: ae.add.head
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                justifyContent: spaceBetween,
                alignItems: center
              }
            children:
              - {
                  id: ae.add.title,
                  type: text,
                  size: [ hug, hug ],
                  content: Add entry,
                  fontSize: 18,
                  fontWeight: 600,
                  letterSpacing: -0.3,
                  color: $text.primary
                }
              - id: ae.add.close
