  - id: note.entry
    type: text
    position: [ 6120, 24 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 700
    color: "#000000"
    content: Entry open

  - id: screen.entry
    type: frame
    position: [ 6120, 88 ]
    size: [ 1440, 1024 ]
    fill: $bg
    layout:
      type: flex
      direction: column
      overflow: hidden
    children:
      - id: entry.topbar
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            justifyContent: spaceBetween,
            alignItems: center,
            padding: [ 20, 32, 0, 32 ]
          }
        children:
          - id: entry.back
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, direction: row, gap: 8, alignItems: center }
            children:
              - {
                  id: entry.back.icon,
                  type: svg,
                  size: [ 13, 13 ],
                  icon: fas:arrow-left,
                  fill: $text.secondary
                }
              - {
                  id: entry.back.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Topics,
                  fontSize: 13,
                  fontWeight: 500,
                  color: $text.secondary
                }
          - id: entry.settings
            type: frame
            size: [ 36, 36 ]
            cornerRadius: 6
            stroke: { color: $border, width: 1, alignment: inside }
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
