          - id: entry.detail
            type: frame
            size: [ fill, hug ]
            cornerRadius: 8
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout: { type: flex, direction: column, gap: 0, padding: 20, overflow: hidden }
            children:
              - id: detail.head
                type: frame
                size: [ fill, hug ]
                layout:
                  {
                    type: flex,
                    direction: row,
                    justifyContent: spaceBetween,
                    alignItems: start
                  }
                children:
                  - id: detail.head.left
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 6 }
                    children:
                      - id: detail.type.badge
                        type: frame
                        size: [ hug, hug ]
                        cornerRadius: 6
                        fill: $muted
                        layout: { type: flex, padding: [ 3, 10 ] }
                        children:
                          - {
                              id: detail.type.text,
                              type: text,
                              size: [ hug, hug ],
                              content: Phrase,
                              fontSize: 12,
                              fontWeight: 600,
                              color: $text.primary
                            }
                      - {
                          id: detail.term,
                          type: text,
                          size: [ hug, hug ],
                          content: security posture,
                          fontSize: 24,
                          fontWeight: 600,
                          letterSpacing: -0.5,
                          color: $text.primary
                        }
                      - {
                          id: detail.transcription,
                          type: text,
                          size: [ hug, hug ],
                          content: "/sɪˈkjʊərəti ˈpɒstʃər/",
                          fontSize: 13,
                          color: $text.secondary
                        }
                      - {
                          id: detail.translation,
                          type: text,
                          size: [ hug, hug ],
                          content: "СОСТОЯНИЕ ЗАЩИЩЁННОСТИ; УРОВЕНЬ БЕЗОПАСНОСТИ",
                          fontSize: 13,
                          fontWeight: 600,
                          letterSpacing: 0.5,
                          color: $text.primary
                        }
                  - id: detail.head.actions
                    type: frame
                    size: [ hug, hug ]
                    layout: { type: flex, direction: row, gap: 8 }
                    children:
                      - id: detail.edit
                        type: frame
                        size: [ 32, 32 ]
                        cornerRadius: 6
                        stroke: { color: $border, width: 1, alignment: inside }
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        children:
                          - {
                              id: detail.edit.icon,
                              type: svg,
                              size: [ 13, 13 ],
                              icon: fas:pencil,
                              fill: $text.secondary
                            }
                      - id: detail.sound
                        type: frame
                        size: [ 32, 32 ]
                        cornerRadius: 6
                        stroke: { color: $border, width: 1, alignment: inside }
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        children:
                          - {
                              id: detail.sound.icon,
                              type: svg,
                              size: [ 13, 13 ],
                              icon: fas:volume-high,
                              fill: $text.secondary
                            }
              - id: detail.source
                type: text
                size: [ fill, hug ]
                margin: [ 8, 0, 0, 0 ]
                content: "Source: Server-side vulnerabilities — PortSwigger"
                fontSize: 13
                color: $text.secondary
              - id: detail.status
                type: frame
                size: [ hug, hug ]
                margin: [ 12, 0, 0, 0 ]
                layout: { type: flex, direction: row, gap: 8 }
                children:
                  - id: status.inbox
                    type: frame
                    size: [ hug, 28 ]
                    cornerRadius: 6
                    fill: $primary
                    layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                    children:
                      - {
                          id: status.inbox.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Inbox,
                          fontSize: 12,
                          fontWeight: 500,
                          color: "#FFFFFF"
                        }
                  - id: status.learning
                    type: frame
                    size: [ hug, 28 ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                    children:
                      - {
                          id: status.learning.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Learning,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.primary
                        }
                  - id: status.known
                    type: frame
                    size: [ hug, 28 ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, alignItems: center, padding: [ 0, 12 ] }
                    children:
                      - {
                          id: status.known.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Known,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.primary
                        }
              - id: detail.sep.1
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: detail.breakdown
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - {
                      id: detail.breakdown.label,
                      type: text,
                      size: [ hug, hug ],
                      margin: [ 12, 0, 0, 0 ],
                      content: Breakdown,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.tertiary
                    }
                  - id: detail.breakdown.text
                    type: text
                    size: [ fill, hug ]
                    fontSize: 13
                    lineHeight: 20
                    color: $text.primary
                    content: |
                      <p><strong>security</strong> — «безопасность», здесь в значении защищённости от атак, а не охраны. В ИТ-контексте устойчиво переводится как «защита / безопасность» системы.</p>
                      <p style="margin-top:8px;"><strong>posture</strong> — многозначное: буквально «осанка, поза»; переносно — «позиция, установка, общее состояние». В связке с security даёт смысл «общая готовность к защите», то есть совокупное состояние defences, а не конкретный механизм.</p>
              - id: detail.sep.2
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: detail.rule
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - {
                      id: detail.rule.label,
                      type: text,
                      size: [ hug, hug ],
                      margin: [ 12, 0, 0, 0 ],
                      content: Rule,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.tertiary
                    }
                  - {
                      id: detail.rule.text,
                      type: text,
                      size: [ fill, hug ],
                      fontSize: 13,
                      lineHeight: 20,
                      color: $text.primary,
                      content: "Устойчивая коллокация «существительное + существительное»: первое
                        слово определяет второе. Аналогично: defence posture —
                        «оборонительная позиция»."
                    }
              - id: detail.sep.3
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: detail.example
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - {
                      id: detail.example.label,
                      type: text,
                      size: [ hug, hug ],
                      margin: [ 12, 0, 0, 0 ],
                      content: How to use it,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.tertiary
                    }
                  - {
                      id: detail.example.text,
                      type: text,
                      size: [ fill, hug ],
                      fontSize: 13,
                      lineHeight: 20,
                      color: $text.primary,
                      content: "Regular audits help maintain a strong security posture. — Регулярные
                        аудиты помогают поддерживать высокий уровень
                        защищённости."
                    }
              - id: detail.sep.4
                type: rect
                size: [ fill, 1 ]
                fill: $border
                margin: [ 16, 0, 0, 0 ]
              - id: detail.actions
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: row, alignItems: center, gap: 8 }
                children:
                  - id: button.askAI
                    type: frame
                    size: [ hug, 32 ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    margin: [ 12, 0, 0, 0 ]
                    layout:
                      {
                        type: flex,
                        direction: row,
                        gap: 6,
                        alignItems: center,
                        padding: [ 0, 12 ]
                      }
                    children:
                      - {
                          id: button.askAI.icon,
                          type: svg,
                          size: [ 11, 11 ],
                          icon: fas:comment-dots,
                          fill: $text.primary
                        }
                      - {
                          id: button.askAI.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Ask the AI agent,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.primary
                        }
                  - id: detail.actions.spacer
                    type: frame
                    size: [ fill, 1 ]
                  - id: button.deleteEntry
                    type: frame
                    size: [ hug, 32 ]
                    cornerRadius: 6
                    margin: [ 12, 0, 0, 0 ]
                    layout:
                      {
                        type: flex,
                        direction: row,
                        gap: 6,
                        alignItems: center,
                        padding: [ 0, 12 ]
                      }
                    children:
                      - {
                          id: button.deleteEntry.icon,
                          type: svg,
                          size: [ 11, 11 ],
                          icon: fas:trash,
                          fill: $destructive
                        }
                      - {
                          id: button.deleteEntry.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Delete entry,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $destructive
                        }
