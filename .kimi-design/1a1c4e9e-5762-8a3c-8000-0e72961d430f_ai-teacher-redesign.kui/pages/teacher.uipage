                        }
              - id: tp.lang.own
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 6 }
                children:
                  - {
                      id: tp.lang.own.label,
                      type: text,
                      size: [ hug, hug ],
                      content: Your language,
                      fontSize: 13,
                      fontWeight: 500,
                      color: $text.primary
                    }
                  - id: tp.lang.own.select
                    type: frame
                    size: [ fill, 40 ]
                    cornerRadius: 6
                    fill: $bg
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout:
                      {
                        type: flex,
                        direction: row,
                        justifyContent: spaceBetween,
                        alignItems: center,
                        padding: [ 0, 12 ]
                      }
                    children:
                      - {
                          id: tp.lang.own.value,
                          type: text,
                          size: [ hug, hug ],
                          content: Russian,
                          fontSize: 14,
                          color: $text.primary
                        }
                      - {
                          id: tp.lang.own.chevron,
                          type: svg,
                          size: [ 12, 12 ],
                          icon: fas:chevron-down,
                          fill: $text.tertiary
                        }
          - id: tp.program
            type: frame
            size: [ 704, hug ]
            cornerRadius: 8
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout: { type: flex, direction: column, gap: 12, padding: 20 }
            children:
              - id: tp.program.head
                type: frame
                size: [ fill, hug ]
                layout:
                  {
                    type: flex,
                    direction: row,
                    justifyContent: spaceBetween,
                    alignItems: center
                  }
                children:
                  - {
                      id: tp.program.title,
                      type: text,
                      size: [ hug, hug ],
                      content: Program · level B1,
                      fontSize: 16,
                      fontWeight: 600,
                      color: $text.primary
                    }
                  - id: tp.program.badge
                    type: frame
                    size: [ hug, hug ]
                    cornerRadius: 6
                    fill: $muted
                    layout: { type: flex, padding: [ 3, 10 ] }
                    children:
                      - {
                          id: tp.program.badge.text,
                          type: text,
                          size: [ hug, hug ],
                          content: 1 of 9 topics,
                          fontSize: 12,
                          fontWeight: 600,
                          color: $text.secondary
                        }
              - {
                  id: tp.program.desc,
                  type: text,
                  size: [ fill, hug ],
                  content: "Уровень B1 подтверждён: вы уверенно справляетесь с базовой грамматикой
                    и лексикой (24 из 32), понимаете простые и средние тексты.
                    Основные пробелы — времена Perfect и Continuous,
                    относительные придаточные, модальные глаголы обязательства.",
                  fontSize: 14,
                  lineHeight: 21,
                  color: $text.secondary
                }
              - id: tp.program.actions
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: row, gap: 8 }
                children:
                  - id: tp.program.finalTest
                    type: frame
                    size: [ hug, 36 ]
                    cornerRadius: 6
                    fill: $primary
                    layout: { type: flex, alignItems: center, padding: [ 0, 16 ] }
                    children:
                      - {
                          id: tp.program.finalTest.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Take the final test,
                          fontSize: 13,
                          fontWeight: 500,
                          color: "#FFFFFF"
                        }
                  - id: tp.program.reset
                    type: frame
                    size: [ hug, 36 ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, alignItems: center, padding: [ 0, 16 ] }
                    children:
                      - {
                          id: tp.program.reset.text,
                          type: text,
                          size: [ hug, hug ],
                          content: Reset the level,
                          fontSize: 13,
                          fontWeight: 500,
                          color: $text.primary
                        }

          - id: tp.topic.1
            type: frame
            size: [ 704, hug ]
            cornerRadius: 8
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              type: flex
              direction: column
              overflow: hidden
            children:
              - id: tp.topic.1.head
                type: frame
                size: [ fill, hug ]
                stroke: { color: $border, width: [ 0, 0, 1, 0 ], alignment: inside }
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 12,
                    alignItems: center,
                    padding: [ 14, 16 ]
                  }
                children:
                  - id: tp.topic.1.num
                    type: frame
                    size: [ 32, 32 ]
                    cornerRadius: 16
                    fill: $muted
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: tp.topic.1.num.text,
                          type: text,
                          size: [ hug, hug ],
                          content: "1",
                          fontSize: 13,
                          fontWeight: 600,
                          color: $text.primary
                        }
                  - id: tp.topic.1.texts
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 2 }
                    children:
                      - {
                          id: tp.topic.1.title,
                          type: text,
                          size: [ fill, hug ],
                          content: "Present Perfect vs Present Continuous",
                          fontSize: 14,
                          fontWeight: 600,
                          color: $text.primary,
                          maxLines: 1
                        }
                      - {
                          id: tp.topic.1.meta,
                          type: text,
                          size: [ hug, hug ],
                          content: Grammar,
                          fontSize: 12,
                          color: $text.tertiary
                        }
                  - id: tp.topic.1.badge
                    type: frame
                    size: [ hug, hug ]
                    cornerRadius: 6
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, padding: [ 3, 10 ] }
                    children:
                      - {
                          id: tp.topic.1.badge.text,
                          type: text,
                          size: [ hug, hug ],
                          content: completed,
                          fontSize: 12,
                          fontWeight: 500,
                          color: $text.secondary
                        }
                  - {
                      id: tp.topic.1.chevron,
                      type: svg,
                      size: [ 12, 12 ],
                      icon: fas:chevron-down,
                      fill: $text.tertiary
                    }
              - id: tp.topic.1.body
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 12, padding: [ 16, 16, 20, 16 ] }
                children:
                  - {
                      id: tp.topic.1.desc,
                      type: text,
                      size: [ fill, hug ],
                      content: "Правильно выбирать между have lived и are living, понимать, что since
                        2015 требует Present Perfect для действия, начавшегося в
                        прошлом и продолжающегося сейчас.",
                      fontSize: 13,
                      lineHeight: 19,
                      color: $text.secondary
                    }
                  - id: tp.ex.1
                    type: frame
                    size: [ fill, hug ]
                    cornerRadius: 8
                    fill: $muted
                    layout: { type: flex, direction: column, gap: 10, padding: 16, alignItems: start }
                    children:
                      - {
                          id: tp.ex.1.hintLabel,
                          type: text,
                          size: [ hug, hug ],
                          content: Exercise hint,
                          fontSize: 12,
                          fontWeight: 600,
                          color: $text.secondary
                        }
                      - {
                          id: tp.ex.1.hint,
                          type: text,
                          size: [ fill, hug ],
                          content: "Правильно выбирать между have lived и are living, понимать, что since
                            2015 требует Present Perfect.",
                          fontSize: 13,
                          lineHeight: 19,
                          color: $text.primary
                        }
                      - { id: tp.ex.1.divider, type: frame, size: [ fill, 1 ], fill: $border }
                      - {
                          id: tp.ex.1.answerLabel,
                          type: text,
                          size: [ hug, hug ],
                          content: Correct answer,
                          fontSize: 12,
                          fontWeight: 600,
                          color: $text.secondary
                        }
                      - {
                          id: tp.ex.1.answer,
                          type: text,
                          size: [ hug, hug ],
                          content: have lived,
                          fontSize: 14,
                          fontWeight: 600,
                          color: $success
                        }
                      - id: tp.ex.1.discuss
                        type: frame
                        size: [ hug, 32 ]
                        cornerRadius: 6
                        fill: $bg
                        stroke: { color: $border, width: 1, alignment: inside }
                        layout:
                          {
                            type: flex,
                            direction: row,
                            gap: 6,
                            alignItems: center,
                            padding: [ 0, 12 ]
                          }
                        children:
                          - {
                              id: tp.ex.1.discuss.icon,
                              type: svg,
                              size: [ 12, 12 ],
                              icon: fas:comment,
                              fill: $text.primary
                            }
                          - {
                              id: tp.ex.1.discuss.text,
                              type: text,
                              size: [ hug, hug ],
                              content: Discuss with the teacher,
                              fontSize: 12,
                              fontWeight: 500,
                              color: $text.primary
                            }
                  - id: tp.ex.1.question
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: row, gap: 8, alignItems: center }
                    children:
                      - {
                          id: tp.ex.1.q.text,
                          type: text,
                          size: [ hug, hug ],
                          content: "I ... in London since 2015.",
                          fontSize: 14,
                          fontWeight: 600,
                          color: $text.primary
                        }
                      - id: tp.ex.1.q.badge
                        type: frame
                        size: [ hug, hug ]
                        cornerRadius: 6
                        fill: "#16A34A14"
                        layout: { type: flex, padding: [ 2, 8 ] }
                        children:
                          - {
                              id: tp.ex.1.q.badge.text,
                              type: text,
                              size: [ hug, hug ],
                              content: done,
                              fontSize: 11,
                              fontWeight: 600,
                              color: $success
                            }
                  - id: tp.ex.1.options
                    type: frame
                    size: [ fill, hug ]
                    layout: { type: flex, direction: column, gap: 8 }
                    children:
                      - id: tp.opt.1
                        type: frame
                        size: [ fill, 40 ]
                        cornerRadius: 6
                        fill: $muted
                        stroke: { color: $primary, width: 1, alignment: inside }
                        layout:
                          {
                            type: flex,
                            direction: row,
                            justifyContent: spaceBetween,
                            alignItems: center,
                            padding: [ 0, 14 ]
                          }
                        children:
                          - {
                              id: tp.opt.1.text,
                              type: text,
                              size: [ hug, hug ],
                              content: have lived,
                              fontSize: 14,
                              fontWeight: 600,
                              color: $text.primary
                            }
                          - {
                              id: tp.opt.1.check,
                              type: svg,
                              size: [ 12, 12 ],
                              icon: fas:check,
                              fill: $success
                            }
                      - id: tp.opt.2
                        type: frame
                        size: [ fill, 40 ]
                        cornerRadius: 6
                        stroke: { color: $border, width: 1, alignment: inside }
                        layout: { type: flex, alignItems: center, padding: [ 0, 14 ] }
                        children:
                          - {
                              id: tp.opt.2.text,
                              type: text,
                              size: [ hug, hug ],
                              content: am living,
                              fontSize: 14,
                              color: $text.primary
                            }
                      - id: tp.opt.3
                        type: frame
                        size: [ fill, 40 ]
                        cornerRadius: 6
                        stroke: { color: $border, width: 1, alignment: inside }
                        layout: { type: flex, alignItems: center, padding: [ 0, 14 ] }
                        children:
                          - {
                              id: tp.opt.3.text,
                              type: text,
                              size: [ hug, hug ],
                              content: live,
                              fontSize: 14,
                              color: $text.primary
                            }
                      - id: tp.opt.4
                        type: frame
                        size: [ fill, 40 ]
                        cornerRadius: 6
                        stroke: { color: $border, width: 1, alignment: inside }
                        layout: { type: flex, alignItems: center, padding: [ 0, 14 ] }
                        children:
                          - {
                              id: tp.opt.4.text,
                              type: text,
                              size: [ hug, hug ],
                              content: lived,
                              fontSize: 14,
                              color: $text.primary
                            }
          - id: tp.topic.2
            type: frame
            size: [ 704, hug ]
            cornerRadius: 8
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              {
                type: flex,
                direction: row,
                gap: 12,
                alignItems: center,
                padding: [ 14, 16 ]
              }
            children:
              - id: tp.topic.2.num
                type: frame
                size: [ 32, 32 ]
                cornerRadius: 16
                fill: $muted
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: tp.topic.2.num.text,
                      type: text,
                      size: [ hug, hug ],
                      content: "2",
                      fontSize: 13,
                      fontWeight: 600,
                      color: $text.primary
                    }
              - id: tp.topic.2.texts
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: tp.topic.2.title,
                      type: text,
                      size: [ fill, hug ],
                      content: "Относительные придаточные: whose, which, who",
                      fontSize: 14,
                      fontWeight: 600,
                      color: $text.primary,
                      maxLines: 1
                    }
                  - {
                      id: tp.topic.2.meta,
                      type: text,
                      size: [ hug, hug ],
                      content: Grammar,
                      fontSize: 12,
                      color: $text.tertiary
                    }
              - id: tp.topic.2.badge
                type: frame
                size: [ hug, hug ]
                cornerRadius: 6
                fill: $primary
                layout: { type: flex, padding: [ 3, 10 ] }
                children:
                  - {
                      id: tp.topic.2.badge.text,
                      type: text,
                      size: [ hug, hug ],
                      content: In progress,
                      fontSize: 12,
                      fontWeight: 500,
                      color: "#FFFFFF"
                    }
              - {
                  id: tp.topic.2.chevron,
                  type: svg,
                  size: [ 12, 12 ],
                  icon: fas:chevron-right,
                  fill: $text.tertiary
                }
          - id: tp.topic.3
            type: frame
            size: [ 704, hug ]
            cornerRadius: 8
            fill: $bg
            stroke: { color: $border, width: 1, alignment: inside }
            layout:
              {
                type: flex,
                direction: row,
                gap: 12,
                alignItems: center,
                padding: [ 14, 16 ]
              }
            children:
              - id: tp.topic.3.num
                type: frame
                size: [ 32, 32 ]
                cornerRadius: 16
                fill: $muted
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: tp.topic.3.num.text,
                      type: text,
                      size: [ hug, hug ],
                      content: "3",
                      fontSize: 13,
                      fontWeight: 600,
                      color: $text.primary
                    }
              - id: tp.topic.3.texts
                type: frame
                size: [ fill, hug ]
                layout: { type: flex, direction: column, gap: 2 }
                children:
                  - {
                      id: tp.topic.3.title,
                      type: text,
                      size: [ fill, hug ],
                      content: "Модальные глаголы обязательства: mustn't, don't have to, have to",
                      fontSize: 14,
                      fontWeight: 600,
                      color: $text.primary,
                      maxLines: 1
                    }
                  - {
                      id: tp.topic.3.meta,
                      type: text,
                      size: [ hug, hug ],
                      content: Grammar,
                      fontSize: 12,
                      color: $text.tertiary
                    }
              - id: tp.topic.3.badge
                type: frame
                size: [ hug, hug ]
                cornerRadius: 6
                stroke: { color: $border, width: 1, alignment: inside }
                layout: { type: flex, padding: [ 3, 10 ] }
                children:
                  - {
                      id: tp.topic.3.badge.text,
                      type: text,
                      size: [ hug, hug ],
                      content: not started,
                      fontSize: 12,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - {
                  id: tp.topic.3.chevron,
                  type: svg,
                  size: [ 12, 12 ],
                  icon: fas:chevron-right,
                  fill: $text.tertiary
                }

prototype: |
  flow start = "screen.start" {
    viewport: [1440, 1024]
  }

  on click("card.beginner") {
    navigate("screen.lesson", transition: none())
  }

  on click("card.chat") {
    navigate("screen.lesson", transition: none())
  }

  on click("card.check") {
    navigate("screen.lesson", transition: none())
  }

  on click("card.grammar") {
    navigate("screen.lesson", transition: none())
  }

  on click("button.newLesson") {
    back(transition: none())
  }

  on click("nav.topics") {
    navigate("screen.topics", transition: none())
  }

  on click("nav2.topics") {
    navigate("screen.topics", transition: none())
  }

  on click("nav3.chat") {
    navigate("screen.start", transition: none())
  }

  on click("topics.start.2") {
    navigate("screen.lesson", transition: none())
  }

  on click("topics.start.3") {
    navigate("screen.lesson", transition: none())
  }

  on click("topics.start.4") {
    navigate("screen.lesson", transition: none())
  }

  on click("topics.start.5") {
    navigate("screen.lesson", transition: none())
  }

  on click("topics.start.6") {
    navigate("screen.lesson", transition: none())
  }

  on click("row.1.topic") {
    navigate("screen.vocab", transition: none())
  }

  on click("topics.start.1") {
    navigate("screen.vocab", transition: none())
  }

  on click("vocab.back") {
    navigate("screen.topics", transition: none())
  }

  on click("entry.back") {
    back(transition: none())
  }

  on click("entry.1") {
    navigate("screen.entry", transition: none())
  }

  on click("button.addEntry") {
    navigate("screen.addEntry", transition: dissolve(180))
  }

  on click("button.addEntry2") {
    navigate("screen.addEntry", transition: dissolve(180))
  }

  on click("ae.add.close") {
    back(transition: dissolve(150))
  }

  on click("ae.button.saveEntry") {
    back(transition: dissolve(150))
  }

  on click("nav.teacher") {
    navigate("screen.teacher", transition: none())
  }

  on click("nav2.teacher") {
    navigate("screen.teacher", transition: none())
  }

  on click("nav3.teacher") {
    navigate("screen.teacher", transition: none())
  }

  on click("nav4.topics") {
    navigate("screen.topics", transition: none())
  }

  on click("nav4.chat") {
    navigate("screen.start", transition: none())
  }
