                  id: entry.settings.icon,
                  type: svg,
                  size: [ 15, 15 ],
                  icon: fas:gear,
                  fill: $text.secondary
                }
      - id: entry.heading
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 4, padding: [ 16, 32, 0, 32 ] }
        children:
