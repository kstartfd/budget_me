                size: [ hug, fill ]
                cornerRadius: 4
                layout: { type: flex, alignItems: center, padding: [ 0, 14 ] }
                children:
                  - {
                      id: vtab.learning.text,
                      type: text,
                      size: [ hug, hug ],
