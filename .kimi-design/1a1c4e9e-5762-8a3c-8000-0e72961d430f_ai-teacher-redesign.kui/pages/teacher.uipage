name: AI Teacher

children:
  - id: note.start
    type: text
    position: [ 40, 24 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 700
    color: "#000000"
    content: Empty state

  - id: screen.start
    type: frame
    position: [ 40, 88 ]
    size: [ 1440, 1024 ]
    fill: $bg
    layout:
      type: flex
      direction: row
      overflow: hidden
    children:
      - id: sidebar
        type: frame
        size: [ 272, fill ]
        fill: $bg
        stroke: { color: $border, width: [ 0, 1, 0, 0 ], alignment: inside }
        layout:
          type: flex
          direction: column
          padding: [ 20, 16 ]
        children:
          - id: sb.logo
            type: frame
            size: [ fill, hug ]
            margin: [ 0, 0, 28, 0 ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 10,
                alignItems: center,
                padding: [ 4, 8 ]
              }
            children:
              - id: sb.logo.mark
                type: frame
                size: [ 28, 28 ]
                cornerRadius: 6
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: sb.logo.icon,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:graduation-cap,
                      fill: "#FFFFFF"
                    }
              - {
                  id: sb.logo.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Topics,
                  fontSize: 15,
                  fontWeight: 600,
                  letterSpacing: -0.2,
                  color: $text.primary
                }
          - id: sb.nav
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - id: nav.topics
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav.topics.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:layer-group,
                      fill: $text.secondary
                    }
                  - {
                      id: nav.topics.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Topics,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: nav.teacher
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav.teacher.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:chalkboard-user,
                      fill: $text.secondary
                    }
                  - {
                      id: nav.teacher.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Teacher,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: nav.chat
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                fill: $muted
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav.chat.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:comment-dots,
                      fill: $text.primary
                    }
                  - {
                      id: nav.chat.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Chat,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.primary
                    }
              - id: nav.settings
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav.settings.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:gear,
                      fill: $text.secondary
                    }
                  - {
                      id: nav.settings.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Settings,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.secondary
                    }
          - id: sb.label.recent
            type: text
            size: [ hug, hug ]
            margin: [ 24, 12, 6, 12 ]
            content: Recent lessons
            fontSize: 12
            fontWeight: 500
            color: $text.secondary
          - id: sb.lessons
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - id: lesson.1
                type: frame
                size: [ fill, hug ]
                cornerRadius: 6
                layout: { type: flex, direction: column, gap: 2, padding: [ 8, 12 ] }
                children:
                  - {
                      id: lesson.1.title,
                      type: text,
                      size: [ fill, hug ],
                      content: Ordering food in a cafe,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.primary,
                      maxLines: 1
                    }
                  - {
                      id: lesson.1.meta,
                      type: text,
                      size: [ hug, hug ],
                      content: 18 messages,
                      fontSize: 12,
                      color: $text.tertiary
                    }
              - id: lesson.2
                type: frame
                size: [ fill, hug ]
                cornerRadius: 6
                layout: { type: flex, direction: column, gap: 2, padding: [ 8, 12 ] }
                children:
                  - {
                      id: lesson.2.title,
                      type: text,
                      size: [ fill, hug ],
                      content: Job interview practice,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.primary,
                      maxLines: 1
                    }
                  - {
                      id: lesson.2.meta,
                      type: text,
                      size: [ hug, hug ],
                      content: 32 messages,
                      fontSize: 12,
                      color: $text.tertiary
                    }
              - id: lesson.3
                type: frame
                size: [ fill, hug ]
                cornerRadius: 6
                layout: { type: flex, direction: column, gap: 2, padding: [ 8, 12 ] }
                children:
                  - {
                      id: lesson.3.title,
                      type: text,
                      size: [ fill, hug ],
                      content: Past Simple review,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.primary,
                      maxLines: 1
                    }
                  - {
                      id: lesson.3.meta,
                      type: text,
                      size: [ hug, hug ],
                      content: 12 messages,
                      fontSize: 12,
                      color: $text.tertiary
                    }
          - id: sb.spacer
            type: frame
            size: [ fill, fill ]
          - id: sb.lang
            type: frame
            size: [ fill, 36 ]
            cornerRadius: 6
            fill: $muted
            layout: { type: flex, direction: row, padding: 4, gap: 2 }
            children:
              - id: sb.lang.ru
                type: frame
                size: [ fill, fill ]
                cornerRadius: 4
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: sb.lang.ru.text,
                      type: text,
                      size: [ hug, hug ],
                      content: RU,
                      fontSize: 13,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: sb.lang.en
                type: frame
                size: [ fill, fill ]
                cornerRadius: 4
                fill: $bg
                effects: { type: shadow, color: "#0000000F", offset: [ 0, 1 ], blur: 2 }
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: sb.lang.en.text,
                      type: text,
                      size: [ hug, hug ],
                      content: EN,
                      fontSize: 13,
                      fontWeight: 500,
                      color: $text.primary
                    }
          - id: sb.user
            type: frame
            size: [ fill, hug ]
            margin: [ 12, 0, 0, 0 ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 10,
                alignItems: center,
                padding: [ 4, 8 ]
              }
            children:
              - id: sb.user.avatar
                type: frame
                size: [ 32, 32 ]
                cornerRadius: 16
                fill: $muted
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: sb.user.initials,
                      type: text,
                      size: [ hug, hug ],
                      content: AK,
                      fontSize: 12,
                      fontWeight: 600,
                      color: $text.primary
                    }
              - id: sb.user.name
                type: text
                size: [ fill, hug ]
                content: Alex Kim
                fontSize: 14
                fontWeight: 500
                color: $text.primary
              - {
                  id: sb.user.theme,
                  type: svg,
                  size: [ 16, 16 ],
                  icon: fas:sun,
                  fill: $text.secondary
                }
      - id: main
        type: frame
        size: [ fill, fill ]
        layout:
          type: flex
          direction: column
          overflow: hidden
        children:
          - id: header
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: row,
                justifyContent: spaceBetween,
                alignItems: start,
                padding: [ 24, 32, 20, 32 ]
              }
            children:
              - id: header.title.block
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: column, gap: 4 }
                children:
                  - {
                      id: header.title,
                      type: text,
                      size: [ hug, hug ],
                      content: AI Teacher,
                      fontSize: 24,
                      fontWeight: 600,
                      letterSpacing: -0.5,
                      color: $text.primary
                    }
                  - {
                      id: header.subtitle,
                      type: text,
                      size: [ hug, hug ],
                      content: Free conversation in the language you learn. The teacher leads the
                        lesson and corrects your mistakes.,
                      fontSize: 14,
                      color: $text.secondary
                    }
              - id: header.actions
                type: frame
                size: [ hug, hug ]
                layout: { type: flex, direction: row, gap: 8, alignItems: center }
                children:
                  - id: header.lang
                    type: frame
                    size: [ hug, 36 ]
                    cornerRadius: 6
                    fill: $bg
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout:
                      {
                        type: flex,
                        direction: row,
                        gap: 8,
                        alignItems: center,
                        padding: [ 0, 12 ]
                      }
                    children:
                      - {
                          id: header.lang.icon,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: fas:globe,
                          fill: $text.secondary
                        }
                      - {
                          id: header.lang.text,
                          type: text,
                          size: [ hug, hug ],
                          content: English,
                          fontSize: 14,
                          fontWeight: 500,
                          color: $text.primary
                        }
                      - {
                          id: header.lang.chevron,
                          type: svg,
                          size: [ 11, 11 ],
                          icon: fas:chevron-down,
                          fill: $text.tertiary
                        }
                  - id: header.history
                    type: frame
                    size: [ 36, 36 ]
                    cornerRadius: 6
                    fill: $bg
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: header.history.icon,
                          type: svg,
                          size: [ 15, 15 ],
                          icon: fas:clock-rotate-left,
                          fill: $text.secondary
                        }
          - id: hero
            type: frame
            size: [ fill, fill ]
            layout:
              {
                type: flex,
                direction: column,
                alignItems: center,
                justifyContent: center,
                padding: [ 0, 32 ]
              }
            children:
              - id: hero.icon
                type: frame
                size: [ 48, 48 ]
                cornerRadius: 8
                fill: $muted
                margin: [ 0, 0, 20, 0 ]
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: hero.icon.svg,
                      type: svg,
                      size: [ 22, 22 ],
                      icon: fas:graduation-cap,
                      fill: $text.primary
                    }
              - id: hero.title
                type: text
                size: [ hug, hug ]
                margin: [ 0, 0, 8, 0 ]
                content: Let's start a lesson
                fontSize: 30
                fontWeight: 600
                letterSpacing: -0.5
                color: $text.primary
              - id: hero.subtitle
                type: text
                size: [ 440, hug ]
                margin: [ 0, 0, 32, 0 ]
                content: Write anything or pick a way to begin. The teacher finds your level and
                  leads the lesson.
                fontSize: 15
                lineHeight: 22
                align: [ center, top ]
                color: $text.secondary
              - id: hero.cards
                type: frame
                size: [ hug, hug ]
                layout:
                  type: grid
                  rows: [ auto, auto ]
                  columns: [ 324, 324 ]
                  gap: 12
                children:
                  - id: card.beginner
                    type: frame
                    size: [ fill, hug ]
                    cornerRadius: 8
                    fill: $bg
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, direction: row, gap: 12, alignItems: center, padding: 16 }
                    children:
                      - id: card.beginner.icon
                        type: frame
                        size: [ 36, 36 ]
                        cornerRadius: 6
                        fill: $muted
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        children:
                          - {
                              id: card.beginner.icon.svg,
                              type: svg,
                              size: [ 15, 15 ],
                              icon: fas:seedling,
                              fill: $text.primary
                            }
                      - id: card.beginner.text
                        type: frame
                        size: [ fill, hug ]
                        layout: { type: flex, direction: column, gap: 2 }
                        children:
                          - {
                              id: card.beginner.title,
                              type: text,
                              size: [ hug, hug ],
                              content: I'm a beginner,
                              fontSize: 14,
                              fontWeight: 600,
                              color: $text.primary
                            }
                          - {
                              id: card.beginner.desc,
                              type: text,
                              size: [ fill, hug ],
                              content: Start with the basics,
                              fontSize: 13,
                              color: $text.secondary
                            }
                  - id: card.chat
                    type: frame
                    size: [ fill, hug ]
                    cornerRadius: 8
                    fill: $bg
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, direction: row, gap: 12, alignItems: center, padding: 16 }
                    children:
                      - id: card.chat.icon
                        type: frame
                        size: [ 36, 36 ]
                        cornerRadius: 6
                        fill: $muted
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        children:
                          - {
                              id: card.chat.icon.svg,
                              type: svg,
                              size: [ 15, 15 ],
                              icon: fas:comments,
                              fill: $text.primary
                            }
                      - id: card.chat.text
                        type: frame
                        size: [ fill, hug ]
                        layout: { type: flex, direction: column, gap: 2 }
                        children:
                          - {
                              id: card.chat.title,
                              type: text,
                              size: [ hug, hug ],
                              content: Let's just chat,
                              fontSize: 14,
                              fontWeight: 600,
                              color: $text.primary
                            }
                          - {
                              id: card.chat.desc,
                              type: text,
                              size: [ fill, hug ],
                              content: Casual conversation on any topic,
                              fontSize: 13,
                              color: $text.secondary
                            }
                  - id: card.check
                    type: frame
                    size: [ fill, hug ]
                    cornerRadius: 8
                    fill: $bg
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, direction: row, gap: 12, alignItems: center, padding: 16 }
                    children:
                      - id: card.check.icon
                        type: frame
                        size: [ 36, 36 ]
                        cornerRadius: 6
                        fill: $muted
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        children:
                          - {
                              id: card.check.icon.svg,
                              type: svg,
                              size: [ 15, 15 ],
                              icon: fas:spell-check,
                              fill: $text.primary
                            }
                      - id: card.check.text
                        type: frame
                        size: [ fill, hug ]
                        layout: { type: flex, direction: column, gap: 2 }
                        children:
                          - {
                              id: card.check.title,
                              type: text,
                              size: [ hug, hug ],
                              content: Check my sentences,
                              fontSize: 14,
                              fontWeight: 600,
                              color: $text.primary
                            }
                          - {
                              id: card.check.desc,
                              type: text,
                              size: [ fill, hug ],
                              content: Corrections with clear explanations,
                              fontSize: 13,
                              color: $text.secondary
                            }
                  - id: card.grammar
                    type: frame
                    size: [ fill, hug ]
                    cornerRadius: 8
                    fill: $bg
                    stroke: { color: $border, width: 1, alignment: inside }
                    layout: { type: flex, direction: row, gap: 12, alignItems: center, padding: 16 }
                    children:
                      - id: card.grammar.icon
                        type: frame
                        size: [ 36, 36 ]
                        cornerRadius: 6
                        fill: $muted
                        layout: { type: flex, alignItems: center, justifyContent: center }
                        children:
                          - {
                              id: card.grammar.icon.svg,
                              type: svg,
                              size: [ 15, 15 ],
                              icon: fas:book-open,
                              fill: $text.primary
                            }
                      - id: card.grammar.text
                        type: frame
                        size: [ fill, hug ]
                        layout: { type: flex, direction: column, gap: 2 }
                        children:
                          - {
                              id: card.grammar.title,
                              type: text,
                              size: [ hug, hug ],
                              content: Go through grammar,
                              fontSize: 14,
                              fontWeight: 600,
                              color: $text.primary
                            }
                          - {
                              id: card.grammar.desc,
                              type: text,
                              size: [ fill, hug ],
                              content: Structured practice with rules,
                              fontSize: 13,
                              color: $text.secondary
                            }
          - id: composer
            type: frame
            size: [ fill, hug ]
            layout:
              {
                type: flex,
                direction: column,
                alignItems: center,
                padding: [ 16, 32, 24, 32 ]
              }
            children:
              - id: composer.bar
                type: frame
                size: [ 680, 52 ]
                cornerRadius: 8
                fill: $bg
                stroke: { color: $border, width: 1, alignment: inside }
                effects: { type: shadow, color: "#0000000D", offset: [ 0, 1 ], blur: 2 }
                layout:
                  {
                    type: flex,
                    direction: row,
                    alignItems: center,
                    gap: 8,
                    padding: [ 0, 8, 0, 16 ]
                  }
                children:
                  - {
                      id: composer.placeholder,
                      type: text,
                      size: [ fill, hug ],
                      content: Write a message...,
                      fontSize: 14,
                      color: $text.tertiary
                    }
                  - id: composer.mic
                    type: frame
                    size: [ 36, 36 ]
                    cornerRadius: 6
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: composer.mic.icon,
                          type: svg,
                          size: [ 15, 15 ],
                          icon: fas:microphone,
                          fill: $text.secondary
                        }
                  - id: composer.send
                    type: frame
                    size: [ 36, 36 ]
                    cornerRadius: 6
                    fill: $primary
                    layout: { type: flex, alignItems: center, justifyContent: center }
                    children:
                      - {
                          id: composer.send.icon,
                          type: svg,
                          size: [ 14, 14 ],
                          icon: fas:arrow-up,
                          fill: "#FFFFFF"
                        }
  - id: note.lesson
    type: text
    position: [ 1560, 24 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 700
    color: "#000000"
    content: Active lesson

  - id: screen.lesson
    type: frame
    position: [ 1560, 88 ]
    size: [ 1440, 1024 ]
    fill: $bg
    layout:
      type: flex
      direction: row
      overflow: hidden
    children:
      - id: sidebar2
        type: frame
        size: [ 272, fill ]
        fill: $bg
        stroke: { color: $border, width: [ 0, 1, 0, 0 ], alignment: inside }
        layout:
          type: flex
          direction: column
          padding: [ 20, 16 ]
        children:
          - id: sb2.logo
            type: frame
            size: [ fill, hug ]
            margin: [ 0, 0, 28, 0 ]
            layout:
              {
                type: flex,
                direction: row,
                gap: 10,
                alignItems: center,
                padding: [ 4, 8 ]
              }
            children:
              - id: sb2.logo.mark
                type: frame
                size: [ 28, 28 ]
                cornerRadius: 6
                fill: $primary
                layout: { type: flex, alignItems: center, justifyContent: center }
                children:
                  - {
                      id: sb2.logo.icon,
                      type: svg,
                      size: [ 14, 14 ],
                      icon: fas:graduation-cap,
                      fill: "#FFFFFF"
                    }
              - {
                  id: sb2.logo.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Topics,
                  fontSize: 15,
                  fontWeight: 600,
                  letterSpacing: -0.2,
                  color: $text.primary
                }
          - id: sb2.nav
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - id: nav2.topics
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav2.topics.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:layer-group,
                      fill: $text.secondary
                    }
                  - {
                      id: nav2.topics.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Topics,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: nav2.teacher
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav2.teacher.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:chalkboard-user,
                      fill: $text.secondary
                    }
                  - {
                      id: nav2.teacher.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Teacher,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.secondary
                    }
              - id: nav2.chat
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                fill: $muted
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav2.chat.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:comment-dots,
                      fill: $text.primary
                    }
                  - {
                      id: nav2.chat.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Chat,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.primary
                    }
              - id: nav2.settings
                type: frame
                size: [ fill, 36 ]
                cornerRadius: 6
                layout:
                  {
                    type: flex,
                    direction: row,
                    gap: 10,
                    alignItems: center,
                    padding: [ 0, 12 ]
                  }
                children:
                  - {
                      id: nav2.settings.icon,
                      type: svg,
                      size: [ 16, 16 ],
                      icon: fas:gear,
                      fill: $text.secondary
                    }
                  - {
                      id: nav2.settings.text,
                      type: text,
                      size: [ hug, hug ],
                      content: Settings,
                      fontSize: 14,
                      fontWeight: 500,
                      color: $text.secondary
                    }
          - id: sb2.label.recent
            type: text
            size: [ hug, hug ]
            margin: [ 24, 12, 6, 12 ]
            content: Recent lessons
            fontSize: 12
            fontWeight: 500
            color: $text.secondary
          - id: sb2.lessons
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, direction: column, gap: 2 }
            children:
              - id: lesson2.1
                type: frame
                size: [ fill, hug ]
                cornerRadius: 6
