  - id: note.vocab
    type: text
    position: [ 4600, 24 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 700
    color: "#000000"
    content: Topic vocab

  - id: screen.vocab
    type: frame
    position: [ 4600, 88 ]
    size: [ 1440, 1024 ]
    fill: $bg
    layout:
      type: flex
      direction: column
      overflow: hidden
    children:
      - id: vocab.topbar
        type: frame
        size: [ fill, hug ]
        layout:
          {
            type: flex,
            direction: row,
            justifyContent: spaceBetween,
            alignItems: center,
            padding: [ 20, 32, 0, 32 ]
          }
        children:
          - id: vocab.back
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, direction: row, gap: 8, alignItems: center }
            children:
              - {
                  id: vocab.back.icon,
                  type: svg,
                  size: [ 13, 13 ],
                  icon: fas:arrow-left,
                  fill: $text.secondary
                }
              - {
                  id: vocab.back.text,
                  type: text,
                  size: [ hug, hug ],
                  content: Topics,
                  fontSize: 13,
                  fontWeight: 500,
                  color: $text.secondary
                }
          - id: vocab.settings
            type: frame
            size: [ 36, 36 ]
            cornerRadius: 6
            stroke: { color: $border, width: 1, alignment: inside }
            layout: { type: flex, alignItems: center, justifyContent: center }
            children:
              - {
                  id: vocab.settings.icon,
                  type: svg,
                  size: [ 15, 15 ],
                  icon: fas:gear,
                  fill: $text.secondary
                }
      - id: vocab.heading
        type: frame
        size: [ fill, hug ]
        layout: { type: flex, direction: column, gap: 4, padding: [ 16, 32, 0, 32 ] }
        children:
          - {
              id: vocab.title,
              type: text,
              size: [ hug, hug ],
              content: English,
              fontSize: 30,
              fontWeight: 600,
              letterSpacing: -0.5,
              color: $text.primary
            }
          - id: vocab.breadcrumbs
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, direction: row, gap: 6, alignItems: center }
            children:
              - {
                  id: vocab.bc.1,
                  type: text,
                  size: [ hug, hug ],
                  content: English,
                  fontSize: 13,
                  color: $text.secondary
                }
              - {
                  id: vocab.bc.arrow,
                  type: svg,
                  size: [ 10, 10 ],
                  icon: fas:arrow-right,
                  fill: $text.tertiary
                }
              - {
                  id: vocab.bc.2,
                  type: text,
                  size: [ hug, hug ],
                  content: Russian,
                  fontSize: 13,
                  color: $text.secondary
                }
