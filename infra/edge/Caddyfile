# Reverse proxy + automatic HTTPS (Let's Encrypt) for both apps on this VPS.
# {$DOMAIN} / {$LEARNING_DOMAIN} are injected from the environment (compose
# passes both; LEARNING_DOMAIN defaults to learning.<DOMAIN>).
#
# Blue-green: each site's routes live in its own *.active.caddy, pointing at
# ONE colour of that app. scripts/bluegreen.sh rewrites the file and runs
# `caddy reload` — a zero-downtime switch that leaves the other app and the
# idle colour untouched. The copies in the repo are only the first-boot
# defaults: on the server bluegreen.sh owns them and the deploy never copies
# them over.

{$DOMAIN} {
	encode gzip

	import /etc/caddy/budget.active.caddy
}

{$LEARNING_DOMAIN} {
	encode zstd gzip

	import /etc/caddy/learning.active.caddy
}
