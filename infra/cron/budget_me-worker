# budget_me deferred-job runner — the schedule that actually deletes accounts
# whose 30-day grace period has run out (cmd/worker; see infra/compose/prod.yml).
#
# INSTALLED AS THE `deploy` USER'S CRONTAB, not /etc/cron.d: the deploy user has
# no passwordless sudo on the box, and it does not need any — it owns
# ~/budget_me and is in the docker group. Reinstall with:
#
#   ssh deploy@<host> 'crontab -l' | grep -q 'rm -T worker' || \
#     ssh deploy@<host> '(crontab -l 2>/dev/null; cat) | crontab -' < infra/cron/budget_me-worker
#
# The account/advice sweep runs twice a day (03:17 and 15:17). Two jobs share it: purging expired
# deletion requests (once a day would be plenty for that alone), and refreshing
# each user's AI advice — that one wants to happen at least twice daily so a
# person who logged spending in the morning gets a fresh take by the afternoon,
# not only after the night pass. Both jobs are idempotent, so a second run costs
# nothing when nothing changed (unchanged facts hash the same and skip the model).
# Day email is a separate short sweep every 15 minutes so each user's local
# morning/evening window is covered without rerunning the paid advice job.
# -T + </dev/null keeps `compose run` from grabbing stdin (the same trap that once
# ate the deploy script). Output goes to ~/budget_me/worker.log — the box has no
# MTA to mail it to.

# budget_me: зачистка аккаунтов + обновление AI-советов, дважды в сутки (cmd/worker)
17 3 * * * cd ~/budget_me && /usr/bin/docker compose --env-file .env -f prod.yml --profile tools run --rm -T worker </dev/null >> ~/budget_me/worker.log 2>&1
17 15 * * * cd ~/budget_me && /usr/bin/docker compose --env-file .env -f prod.yml --profile tools run --rm -T worker </dev/null >> ~/budget_me/worker.log 2>&1

# Local-time Day email digests (09:00 and optionally 18:00 per user's zone).
*/15 * * * * cd ~/budget_me && /usr/bin/docker compose --env-file .env -f prod.yml --profile tools run --rm -T worker day-email </dev/null >> ~/budget_me/day-email.log 2>&1
