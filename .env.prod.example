# ─────────────────────────────────────────────────────────────────────────────
# budget_me — PRODUCTION environment template.
#
# Copy this to  infra/compose/.env  and fill in real values:
#     cp .env.prod.example infra/compose/.env
#
# All prod compose commands pass  --env-file infra/compose/.env  (see Makefile
# and infra/DEPLOY.md), so that is where the live file must live.
#
# NEVER commit the real .env — it holds secrets. The repo .gitignore already
# ignores every file named `.env`, so `infra/compose/.env` stays untracked.
# ─────────────────────────────────────────────────────────────────────────────

# Public domain of the app. Its A record must point at this VPS. Caddy uses it
# to request a Let's Encrypt certificate and to route/CORS-allow the frontend.
DOMAIN=budget.example.com

# Postgres password for the budget_me DB user (also used in DATABASE_URL that
# the backend/migrate services build internally). Generate a strong value:
#     openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-a-strong-password

# Signs session tokens. A guessable value means forgeable sessions — use a long
# random string:
#     openssl rand -hex 32
AUTH_SECRET=change-me-long-random-secret

# Telegram bot token from @BotFather. Verifies Mini App initData. May be left
# empty in a first bring-up (only web login/registration works without it); set
# it once the bot exists.
TELEGRAM_BOT_TOKEN=

# Container images to run, pulled from the GitLab Container Registry. In CI/CD
# (the primary path) the deploy job writes these automatically, pinned to the
# commit SHA. Only set them here for the MANUAL fallback (`make prod.up`); use
# a real tag/SHA rather than `latest` so a redeploy is reproducible. Requires
# `docker login registry.gitlab.com` with a read_registry deploy token first.
BACKEND_IMAGE=registry.gitlab.com/kstartfd/budget_me/backend:latest
FRONTEND_IMAGE=registry.gitlab.com/kstartfd/budget_me/frontend:latest
