DOMAIN=learning.example.com
POSTGRES_PASSWORD=replace-with-random-password
# The same value as budget's: it is the shared account database's role.
ACCOUNT_POSTGRES_PASSWORD=replace-with-random-password
AUTH_SECRET=replace-with-random-secret
TELEGRAM_BOT_TOKEN=token-of-the-new-learning-bot
LEARNING_BOT_URL=https://t.me/your_learning_bot
BACKEND_IMAGE=registry.gitlab.com/your-group/your-project/learning-backend:replace-with-sha
FRONTEND_IMAGE=registry.gitlab.com/your-group/your-project/learning-frontend:replace-with-sha
